# Brevo (formerly Sendinblue) API key — from Brevo dashboard > SMTP & API > API Keys
BREVO_API_KEY=your_brevo_api_key_here

# Must be an email address that is verified as a sender in your Brevo account
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=University Outreach

PORT=8001

# Database Configuration (MySQL)
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=email_marketing_python

# Used to sign login tokens. Set this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=8
